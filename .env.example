# Copy this file to .env.development for local work.
# Both values are safe to commit: a Google OAuth client ID is public by design
# (it ships inside the browser bundle), and the API URL is not a secret.

# Must end in /api - the axios client uses it as-is.
VITE_API_BASE_URL=http://localhost:5000/api

# Create one at https://console.cloud.google.com/apis/credentials
# Add http://localhost:5173 as an authorised JavaScript origin.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
