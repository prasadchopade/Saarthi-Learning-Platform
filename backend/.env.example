# Copy to backend/.env and fill in. Never commit the real .env.

# ---------------------------------------------------------------------------
# Required - the server is not usable without these
# ---------------------------------------------------------------------------
PORT=5000

FRONTEND_URL=http://localhost:5173

# Set to "production" when deployed. This is what makes the auth cookie
# Secure-only - leaving it unset in production sends the cookie over plain HTTP.
NODE_ENV=development

# Local Mongo, or an Atlas connection string.
DB_URL=mongodb://127.0.0.1:27017/saarthi

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_TIMEOUT=1d

# ---------------------------------------------------------------------------
# Google sign-in - required to log in (the app has no password auth)
# https://console.cloud.google.com/apis/credentials
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must be the literal string "postmessage", not a URL.
# The frontend uses useGoogleLogin({ flow: 'auth-code' }), which runs in popup
# mode, and Google requires popup-issued codes to be exchanged against
# redirect_uri=postmessage. Putting a real URL here fails with
# redirect_uri_mismatch. Your site URL still goes in the Google console under
# "Authorised JavaScript origins".
GOOGLE_REDIRECT_URL=postmessage

# ---------------------------------------------------------------------------
# Optional - each unlocks one feature. Leaving one blank disables that feature
# but does not stop the server booting.
# ---------------------------------------------------------------------------

# AI generation (chat, notes, roadmaps, slides). Free key:
# https://aistudio.google.com/app/apikey
# Users can also paste their own key in Profile, which overrides this one.
GEMINI_API_KEY=

# Optional. Defaults to gemini-flash-lite-latest. The free tier meters per
# model, and the full Flash model allows only 20 requests per day, so the lite
# alias is the sensible default on a free key. On a paid key set this to
# gemini-flash-latest for better output. Avoid pinning an exact version -
# pinned versions get retired, which is what broke the original setup.
GEMINI_MODEL=

# Comma-separated admin addresses for the waitlist endpoints.
ADMIN_EMAILS=

REQUIRE_WAITLIST=false

# Transactional email via Zoho SMTP (waitlist confirmations).
ZOHO_EMAIL=
ZOHO_PASS=
SUPPORT_EMAIL=
APP_URL=http://localhost:5173

# Flask transcript service in ../Services - needed for video Q&A.
PYTHON_SERVICE_URL=http://127.0.0.1:5001

# Vector store for transcript search, shared with the Flask service.
QDRANT_URL=
QDRANT_API_KEY=

# Transcript caching. Redis is optional; without it transcripts refetch.
REDIS_URL=

# File uploads (avatars, notebook attachments).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=

# Google Cloud service account JSON for Text-to-Speech, pasted as a single
# line. Only needed for slide narration. Locally you can instead drop the file
# at backend/google_cloud_key.json.
GOOGLE_CLOUD_CREDENTIALS=

# The in-browser code compiler works with no key at all: without RAPIDAPI_KEY
# it uses Judge0's public Community Edition instance, which is free but rate
# limited and best effort. Set RAPIDAPI_KEY to route through the hosted plan
# instead (https://rapidapi.com/judge0-official/api/judge0-ce - free tier, no
# card), or JUDGE0_URL to point at your own instance.
RAPIDAPI_KEY=
JUDGE0_URL=

# Separate content-generation service. Leave blank unless you run one.
CONTENT_SERVICE_URL=
