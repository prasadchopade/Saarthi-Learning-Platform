# Copy to Services/.env and fill in.

# Qdrant vector database. Free tier: https://cloud.qdrant.io
# Use the same cluster the backend points at.
QDRANT_URL=https://your-cluster.cloud.qdrant.io:6333
QDRANT_API_KEY=

# Optional. YouTube blocks most datacentre IPs, so production fetches
# transcripts through a residential proxy. Local development usually works
# without one - you just hit rate limits sooner.
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=
